# First-boot password for the "admin" user (10+ characters). Only used when the database has no users yet.
ADMIN_PASSWORD=
# Seals the console's session cookie. 32+ random characters: openssl rand -base64 36
SESSION_SECRET=
# Patchvia suggests these when a zone is created without nameservers (comma separated)
DEFAULT_NS=ns1.example.com,ns2.example.com
# Addresses or networks allowed to transfer zones (AXFR/IXFR), e.g. 203.0.113.7,10.0.0.0/8. Empty disables transfers.
ALLOW_AXFR_FROM=
# Secondary servers to notify on every change, e.g. 203.0.113.7,ns2.example.net:5353
NOTIFY_TO=
# Identical UDP responses per second allowed to one client network before limiting (0 = off)
RRL_RESPONSES_PER_SECOND=20
# Cluster of several nameservers (see ../docs/CLUSTER.md). Same secret on every node, a different node id on each.
CLUSTER_SECRET=
CLUSTER_NODE_ID=
# The OTHER nodes' API addresses, e.g. ns2.example.com:8081,ns3.example.com:8081
CLUSTER_PEERS=
# Address the API listens on for other nodes (this machine's private IP); 127.0.0.1 for a single server
API_BIND=127.0.0.1
# Which images to run: registry and tag (see ../docs/DEPLOY.md). Defaults are the private images on GitHub.
# PATCHVIA_REGISTRY=ghcr.io/patchvia
# PATCHVIA_TAG=latest
# Optional. Generated and stored in the database when empty.
JWT_SECRET=
# How automation reaches the API, shown in API key examples
DNS_PUBLIC_API_URL=http://127.0.0.1:8081
