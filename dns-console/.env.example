# Where this console's server reaches the DNS API (not the browser)
DNS_API_URL=http://127.0.0.1:8081
# Seals the session cookie: 32+ random characters (openssl rand -base64 36)
SESSION_SECRET=
# Optional: how automation reaches the API, shown in API key and dynamic DNS examples
# DNS_PUBLIC_API_URL=https://dns.example.com
# Optional: console session length in hours (default 8)
# SESSION_HOURS=8
